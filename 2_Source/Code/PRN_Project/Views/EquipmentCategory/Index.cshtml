@model IEnumerable<PRN_Project.Models.CategoryListViewModel>

@{
    ViewData["Title"] = "Danh mục loại thiết bị";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 text-gray-800"><i class='bx bx-category'></i> Quản lý loại thiết bị</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class='bx bx-plus'></i> Thêm danh mục
        </a>
    </div>

    <!-- Data Table -->
    <div class="card shadow mb-4 border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tên danh mục</th>
                            <th>Ngày tạo</th>
                            <th class="text-center">Số lượng thiết bị</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Không có danh mục nào.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-medium text-dark">@item.CategoryName</td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">
                                    <span class="badge bg-info text-dark rounded-pill">@item.EquipmentCount</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                            <i class='bx bx-edit-alt'></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.CategoryId" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"
                                                    onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này? Hành động không thể hoàn tác!');">
                                                <i class='bx bx-trash'></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
