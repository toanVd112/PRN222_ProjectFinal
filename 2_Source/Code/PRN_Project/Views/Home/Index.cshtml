@model PRN_Project.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan hệ thống";
}

@if (User.IsInRole("Admin") && Model.AdminDashboard != null)
{
    var admin = Model.AdminDashboard;
    <div class="row g-4 mb-4">
        <!-- Stat Card 1 -->
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card-premium stat-card">
                <div class="stat-icon blue">
                    <i class='bx bx-laptop'></i>
                </div>
                <div class="stat-details">
                    <h3>@admin.TotalActiveEquipments</h3>
                    <p>Thiết bị đang sử dụng</p>
                </div>
            </div>
        </div>
        
        <!-- Stat Card 2 -->
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card-premium stat-card">
                <div class="stat-icon red">
                    <i class='bx bx-error-alt'></i>
                </div>
                <div class="stat-details">
                    <h3>@admin.PendingIncidents</h3>
                    <p>Sự cố chờ xử lý</p>
                </div>
            </div>
        </div>
        
        <!-- Stat Card 3 -->
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card-premium stat-card">
                <div class="stat-icon orange">
                    <i class='bx bx-wrench'></i>
                </div>
                <div class="stat-details">
                    <h3>@admin.UnderMaintenanceEquipments</h3>
                    <p>Thiết bị đang bảo trì</p>
                </div>
            </div>
        </div>
        
        <!-- Stat Card 4 -->
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card-premium stat-card">
                <div class="stat-icon green">
                    <i class='bx bx-door-open'></i>
                </div>
                <div class="stat-details">
                    <h3>@admin.ActiveRooms</h3>
                    <p>Phòng học hoạt động</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Chart Area -->
        <div class="col-12 col-lg-8">
            <div class="card-premium h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Biểu đồ sự cố theo tháng</h5>
                    <button class="btn btn-primary-custom btn-sm">
                        <i class='bx bx-export'></i> Xuất báo cáo
                    </button>
                </div>
                <div style="height: 300px; background: repeating-linear-gradient(45deg, #f3f4f6, #f3f4f6 10px, #ffffff 10px, #ffffff 20px); border-radius: 8px; display: flex; align-items: center; justify-content: center; border: 1px dashed #cbd5e1;">
                    <span class="text-secondary fw-semibold">Biểu đồ sẽ được cập nhật ở phiên bản sau</span>
                </div>
            </div>
        </div>
        
        <!-- Recent Activity -->
        <div class="col-12 col-lg-4">
            <div class="card-premium h-100">
                <h5 class="fw-bold mb-4">Hoạt động gần đây</h5>
                
                @if (admin.RecentActivities.Any())
                {
                    foreach (var activity in admin.RecentActivities)
                    {
                        <div class="d-flex align-items-start mb-3">
                            <div class="bg-@activity.ColorClass bg-opacity-10 text-@activity.ColorClass p-2 rounded-circle me-3">
                                <i class='bx @activity.IconClass fs-5'></i>
                            </div>
                            <div>
                                <p class="mb-1 fw-semibold text-dark">@activity.Title</p>
                                <p class="mb-0 text-secondary" style="font-size: 0.8rem;">@activity.Description</p>
                                <small class="text-muted">@activity.TimeAgo</small>
                            </div>
                        </div>
                    }
                    
                    <a asp-controller="TechnicianIncidents" asp-action="Index" class="btn btn-link text-primary w-100 mt-3 text-decoration-none fw-semibold">
                        Xem tất cả lịch sử
                    </a>
                }
                else
                {
                    <p class="text-muted text-center py-4">Chưa có hoạt động nào gần đây.</p>
                }
            </div>
        </div>
    </div>
}
else if (User.IsInRole("Technician") && Model.TechnicianDashboard != null)
{
    var tech = Model.TechnicianDashboard;
    <div class="row g-4 mb-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card-premium stat-card">
                <div class="stat-icon red">
                    <i class='bx bx-error-alt'></i>
                </div>
                <div class="stat-details">
                    <h3>@tech.AssignedPendingIncidents</h3>
                    <p>Sự cố được giao</p>
                </div>
            </div>
        </div>
        
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card-premium stat-card">
                <div class="stat-icon green">
                    <i class='bx bx-check-shield'></i>
                </div>
                <div class="stat-details">
                    <h3>@tech.ResolvedIncidents</h3>
                    <p>Đã khắc phục</p>
                </div>
            </div>
        </div>
        
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card-premium stat-card">
                <div class="stat-icon blue">
                    <i class='bx bx-transfer'></i>
                </div>
                <div class="stat-details">
                    <h3>@tech.TotalTransferred</h3>
                    <p>Thiết bị luân chuyển</p>
                </div>
            </div>
        </div>
        
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card-premium stat-card">
                <div class="stat-icon orange">
                    <i class='bx bx-trash'></i>
                </div>
                <div class="stat-details">
                    <h3>@tech.PendingDisposals</h3>
                    <p>Chờ duyệt thanh lý</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card-premium h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Công việc cần xử lý ngay</h5>
                </div>
                
                @if (tech.RecentActivities.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <tbody>
                                @foreach (var activity in tech.RecentActivities)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="bg-@activity.ColorClass bg-opacity-10 text-@activity.ColorClass p-2 rounded-circle me-3">
                                                    <i class='bx @activity.IconClass fs-5'></i>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-semibold">@activity.Title</h6>
                                                    <small class="text-muted">@activity.Description</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <small class="text-muted d-block mb-1">@activity.TimeAgo</small>
                                            <a asp-controller="TechnicianIncidents" asp-action="Details" asp-route-id="@activity.EntityId" class="btn btn-sm btn-outline-primary">Xử lý ngay</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class='bx bx-check-circle text-success' style="font-size: 3rem;"></i>
                        <h6 class="mt-3">Tuyệt vời! Bạn không có công việc nào tồn đọng.</h6>
                    </div>
                }
            </div>
        </div>
        
        <div class="col-12 col-lg-4">
            <div class="card-premium h-100">
                <h5 class="fw-bold mb-4">Lối tắt nhanh</h5>
                <div class="d-grid gap-3">
                    <a asp-controller="Equipments" asp-action="Transfers" class="btn btn-outline-primary text-start p-3 fw-semibold">
                        <i class='bx bx-transfer me-2'></i> Quản lý luân chuyển
                    </a>
                    <a asp-controller="Equipments" asp-action="Disposals" class="btn btn-outline-danger text-start p-3 fw-semibold">
                        <i class='bx bx-trash me-2'></i> Quản lý thanh lý
                    </a>
                    <a asp-controller="TechnicianIncidents" asp-action="Index" class="btn btn-outline-warning text-start p-3 fw-semibold">
                        <i class='bx bx-wrench me-2'></i> Sự cố được giao
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else if (User.IsInRole("Lecturer") && Model.LecturerDashboard != null)
{
    var lecturer = Model.LecturerDashboard;
    <div class="row g-4 mb-4">
        <div class="col-12 col-md-4">
            <div class="card-premium stat-card">
                <div class="stat-icon blue">
                    <i class='bx bx-door-open'></i>
                </div>
                <div class="stat-details">
                    <h3>@lecturer.AssignedRooms</h3>
                    <p>Phòng học phụ trách</p>
                </div>
            </div>
        </div>
        
        <div class="col-12 col-md-4">
            <div class="card-premium stat-card">
                <div class="stat-icon red">
                    <i class='bx bx-error'></i>
                </div>
                <div class="stat-details">
                    <h3>@lecturer.PendingReportedIncidents</h3>
                    <p>Sự cố chưa xử lý</p>
                </div>
            </div>
        </div>
        
        <div class="col-12 col-md-4">
            <div class="card-premium stat-card">
                <div class="stat-icon green">
                    <i class='bx bx-check-double'></i>
                </div>
                <div class="stat-details">
                    <h3>@lecturer.TotalReportedIncidents</h3>
                    <p>Tổng sự cố đã báo</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card-premium h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Tình trạng các báo cáo gần đây</h5>
                </div>
                
                @if (lecturer.RecentActivities.Any())
                {
                    <div class="timeline-container">
                        @foreach (var activity in lecturer.RecentActivities)
                        {
                            <div class="d-flex align-items-start mb-4">
                                <div class="bg-@activity.ColorClass bg-opacity-10 text-@activity.ColorClass p-2 rounded-circle me-3">
                                    <i class='bx @activity.IconClass fs-5'></i>
                                </div>
                                <div>
                                    <h6 class="mb-1 fw-semibold text-dark">@activity.Title</h6>
                                    <p class="mb-1 text-secondary">@activity.Description</p>
                                    <small class="text-muted"><i class='bx bx-time-five me-1'></i>@activity.TimeAgo</small>
                                </div>
                            </div>
                        }
                    </div>
                    <a asp-controller="IncidentReports" asp-action="Index" class="btn btn-outline-primary mt-2">Xem toàn bộ lịch sử</a>
                }
                else
                {
                    <div class="text-center py-4">
                        <p class="text-muted">Bạn chưa gửi báo cáo sự cố nào gần đây.</p>
                    </div>
                }
            </div>
        </div>
        
        <div class="col-12 col-lg-4">
            <div class="card-premium bg-primary text-white h-100 d-flex flex-column justify-content-center align-items-center text-center p-5">
                <div class="bg-white bg-opacity-25 rounded-circle p-4 mb-4">
                    <i class='bx bx-support fs-1'></i>
                </div>
                <h4 class="fw-bold text-white mb-3">Cần hỗ trợ?</h4>
                <p class="mb-4 text-white-50">Báo cáo ngay nếu thiết bị trong phòng học của bạn gặp trục trặc để Kỹ thuật viên xử lý kịp thời.</p>
                <a asp-controller="LecturerRooms" asp-action="Index" class="btn btn-light fw-bold px-4 py-2 text-primary">
                    Báo hỏng thiết bị
                </a>
            </div>
        </div>
    </div>
}
