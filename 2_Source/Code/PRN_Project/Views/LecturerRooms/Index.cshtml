@model PRN_Project.Models.RoomEquipmentViewModel

@{
    ViewData["Title"] = "Thiết bị phòng học";
}

<div class="row g-4">
    <div class="col-12">
        <div class="card-premium">


            <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3 mb-4">
                <div>
                    <h5 class="fw-bold mb-1">Thiết bị phòng học</h5>
                    <p class="text-secondary mb-0">Chọn một phòng đang hoạt động để xem danh sách thiết bị hiện có.</p>
                </div>
                <form asp-controller="LecturerRooms" asp-action="Index" method="get" class="d-flex flex-column flex-sm-row gap-2 align-items-sm-start flex-shrink-0">
                    <div style="min-width: 280px;">
                        <select asp-for="SelectedRoomId" name="roomId" class="form-select" onchange="this.form.submit()" aria-label="Các phòng học">
                            <option value="">-- Các phòng học --</option>
                            @foreach (var room in Model.ActiveRooms)
                            {
                                if (Model.SelectedRoomId == room.RoomId)
                                {
                                    <option value="@room.RoomId" selected>@room.DisplayName</option>
                                }
                                else
                                {
                                    <option value="@room.RoomId">@room.DisplayName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="SelectedRoomId" class="text-danger small"></span>
                    </div>
                </form>
            </div>

            @if (!Model.ActiveRooms.Any())
            {
                <div class="alert alert-info mb-0">
                    Hiện chưa có phòng học nào đang hoạt động.
                </div>
            }
            else if (!Model.SelectedRoomId.HasValue)
            {
                <div class="d-flex flex-column align-items-center justify-content-center text-center py-5 px-3 border rounded-3 bg-light">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mb-3"
                         style="width: 88px; height: 88px;">
                        <i class='bx bx-search-alt-2' style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Chưa chọn phòng học</h5>
                    <p class="text-secondary mb-0" style="max-width: 560px;">
                        Chưa chọn phòng học. Vui lòng chọn một phòng từ danh sách phía trên để hiển thị dữ liệu thiết bị.
                    </p>
                </div>
            }
            else if (!Model.Equipments.Any())
            {
                <div class="alert alert-info mb-0">
                    Hiện chưa có thiết bị nào gán vào phòng này.
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="text-secondary">
                        Phòng: <span class="fw-semibold text-dark">@Model.SelectedRoomName</span>
                    </div>
                    <span class="badge bg-primary-subtle text-primary">@Model.Equipments.Count thiết bị</span>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Mã tài sản</th>
                                <th>Tên thiết bị</th>
                                <th>Loại thiết bị</th>
                                <th>Trạng thái thiết bị</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var equipment in Model.Equipments)
                            {
                                <tr>
                                    <td class="fw-semibold">@equipment.AssetCode</td>
                                    <td>@equipment.EquipmentName</td>
                                    <td>@equipment.CategoryName</td>
                                    <td>
                                        <span class="badge @equipment.StatusBadgeClass">@equipment.StatusText</span>
                                    </td>
                                    <td class="text-end">
                                        @if (equipment.CanReportIncident)
                                        {
                                            <a asp-controller="IncidentReports"
                                               asp-action="Create"
                                               asp-route-equipmentId="@equipment.EquipmentId"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class='bx bx-error'></i> Báo hỏng
                                            </a>
                                        }
                                        else
                                        {
                                            if (equipment.PendingIncidentId.HasValue)
                                            {
                                                <a asp-controller="IncidentReports"
                                                   asp-action="Details"
                                                   asp-route-id="@equipment.PendingIncidentId"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class='bx bx-detail'></i> Xem chi tiết
                                                </a>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                                    <i class='bx bx-lock-alt'></i> Đang xử lý
                                                </button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
