@model IEnumerable<PRN_Project.Models.VwEquipmentDetail>
@{
    ViewData["Title"] = "Kho Thiết bị";
}

<div class="container-fluid p-0">
    <!-- Header Page -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1 fw-bold text-dark">Kho Quản Lý Thiết Bị</h3>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Kho Thiết bị</li>
                </ol>
            </nav>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary-custom">
                <i class='bx bx-plus-circle me-1'></i> Thêm thiết bị mới
            </a>
        </div>
    </div>

    <!-- Alert Success -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class='bx bx-check-circle fs-4 me-2'></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card card-premium mb-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold text-secondary small">Tìm kiếm thiết bị</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class='bx bx-search'></i></span>
                    <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control bg-light border-start-0 ps-0" placeholder="Nhập mã tài sản, tên thiết bị, phòng học...">
                </div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label fw-semibold text-secondary small">Loại thiết bị</label>
                <select name="categoryId" class="form-select bg-light" asp-items="ViewBag.Categories">
                    <option value="">-- Tất cả loại --</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label fw-semibold text-secondary small">Trạng thái</label>
                <select name="status" class="form-select bg-light" asp-items="ViewBag.Statuses">
                    <option value="">-- Tất cả trạng thái --</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-medium">Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 fw-medium">Đặt lại</a>
                </div>
            </div>
        </form>
    </div>

    <!-- Data Card -->
    <div class="card card-premium">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="border-0 ps-3">Mã tài sản</th>
                        <th class="border-0">Tên thiết bị</th>
                        <th class="border-0">Loại thiết bị</th>
                        <th class="border-0">Vị trí phòng</th>
                        <th class="border-0">Ngày mua</th>
                        <th class="border-0">Hạn bảo hành</th>
                        <th class="border-0">Trạng thái</th>
                        <th class="border-0 text-center pe-3" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold text-primary">@item.AssetCode</td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.EquipmentName</div>
                                    <small class="text-muted">ID: @item.EquipmentId</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-weight-normal px-2 py-1.5">
                                        @item.CategoryName
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.RoomCode))
                                    {
                                        <div class="d-flex align-items-center">
                                            <i class='bx bx-door-open me-1 text-primary fs-5'></i>
                                            <span>@item.RoomName <strong class="text-muted">(@item.RoomCode)</strong></span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic"><i class='bx bx-archive-in me-1'></i>Chưa gán phòng</span>
                                    }
                                </td>
                                <td>@(item.PurchaseDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>
                                    @if (item.WarrantyExpiry.HasValue)
                                    {
                                        var isExpired = item.WarrantyExpiry.Value < DateOnly.FromDateTime(DateTime.Today);
                                        <span class="@(isExpired ? "text-danger fw-medium" : "text-dark")">
                                            @item.WarrantyExpiry.Value.ToString("dd/MM/yyyy")
                                            @if (isExpired)
                                            {
                                                <small class="d-block text-danger font-size-xs">(Hết hạn)</small>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "InUse":
                                            <span class="badge bg-success-subtle text-success px-2 py-1.5 border border-success-subtle rounded-pill">Đang sử dụng</span>
                                            break;
                                        case "PendingRepair":
                                            <span class="badge bg-warning-subtle text-warning px-2 py-1.5 border border-warning-subtle rounded-pill">Chờ sửa</span>
                                            break;
                                        case "UnderMaintenance":
                                            <span class="badge bg-info-subtle text-info px-2 py-1.5 border border-info-subtle rounded-pill">Đang bảo trì</span>
                                            break;
                                        case "ProposedDisposal":
                                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1.5 border border-secondary-subtle rounded-pill">Đề xuất thanh lý</span>
                                            break;
                                        case "Disposed":
                                            <span class="badge bg-danger-subtle text-danger px-2 py-1.5 border border-danger-subtle rounded-pill">Đã thanh lý</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark px-2 py-1.5 rounded-pill">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.EquipmentId" class="btn btn-outline-primary btn-sm px-2.5 rounded-3 d-flex align-items-center gap-1" title="Chỉnh sửa">
                                            <i class='bx bx-edit-alt'></i> Sửa
                                        </a>
                                        <!-- Details / History (will connect to UC21 later) -->
                                        <a href="#" class="btn btn-outline-secondary btn-sm px-2.5 rounded-3 d-flex align-items-center gap-1" title="Lịch sử thay đổi">
                                            <i class='bx bx-history'></i> Lịch sử
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class='bx bx-info-circle fs-1 mb-2 d-block text-secondary'></i>
                                Không tìm thấy thiết bị nào khớp với bộ lọc tìm kiếm.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Styling badges for Bootstrap 5 standard alerts and badges */
    .bg-success-subtle { background-color: #d1e7dd !important; }
    .text-success { color: #0f5132 !important; }
    .border-success-subtle { border-color: #a3cfbb !important; }
    
    .bg-warning-subtle { background-color: #fff3cd !important; }
    .text-warning { color: #664d03 !important; }
    .border-warning-subtle { border-color: #ffe69c !important; }
    
    .bg-info-subtle { background-color: #cff4fc !important; }
    .text-info { color: #055160 !important; }
    .border-info-subtle { border-color: #9eeaf9 !important; }

    .bg-danger-subtle { background-color: #f8d7da !important; }
    .text-danger { color: #842029 !important; }
    .border-danger-subtle { border-color: #f1aeb5 !important; }

    .bg-secondary-subtle { background-color: #e2e3e5 !important; }
    .text-secondary { color: #41464b !important; }
    .border-secondary-subtle { border-color: #c4c8cb !important; }

    .font-size-xs { font-size: 0.7rem; }
    .italic { font-style: italic; }
</style>
