@{
    ViewData["Title"] = "Điều chuyển thiết bị";
    var e = ViewBag.Equipment as PRN_Project.Models.Equipment;
}

<div class="container-fluid p-0">
    <!-- Breadcrumb -->
    <div class="mb-4">
        <h3 class="mb-1 fw-bold text-dark">
            <i class='bx bx-transfer-alt me-2 text-primary'></i>Điều Chuyển Vị Trí Thiết Bị
        </h3>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Kho Thiết bị</a></li>
                <li class="breadcrumb-item active">Điều chuyển</li>
            </ol>
        </nav>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class='bx bx-error-circle fs-4 me-2'></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
        </div>
    }

    <div class="card card-premium" style="max-width: 720px; margin: 0 auto;">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
            <div>
                <div class="text-muted small mb-1">Mã tài sản</div>
                <h5 class="fw-bold text-primary mb-0">@(e?.AssetCode ?? "—")</h5>
            </div>
            <div>
                @{
                    var (badgeClass, badgeText) = e?.Status switch {
                        "InUse"           => ("bg-success text-white", "Đang sử dụng"),
                        "PendingRepair"   => ("bg-warning text-dark",  "Chờ sửa"),
                        "UnderMaintenance"=> ("bg-info text-white",    "Đang bảo trì"),
                        "ProposedDisposal"=> ("bg-secondary text-white","Đề xuất thanh lý"),
                        "Disposed"        => ("bg-danger text-white",   "Đã thanh lý"),
                        _                 => ("bg-light text-dark",     e?.Status ?? "—")
                    };
                }
                <span class="badge @badgeClass px-3 py-2 rounded-pill fs-sm">@badgeText</span>
            </div>
        </div>

        <!-- Equipment Overview -->
        <div class="bg-light rounded-3 p-3 mb-4">
            <div class="row g-3">
                <div class="col-12 col-sm-6">
                    <span class="text-muted small d-block">Tên thiết bị</span>
                    <strong class="text-dark">@(e?.EquipmentName ?? "—")</strong>
                </div>
                <div class="col-12 col-sm-6">
                    <span class="text-muted small d-block">Loại thiết bị</span>
                    <strong class="text-dark">@(e?.Category?.CategoryName ?? "—")</strong>
                </div>
                <div class="col-12 col-sm-6">
                    <span class="text-muted small d-block">Vị trí phòng hiện tại</span>
                    <strong class="text-primary d-flex align-items-center">
                        <i class='bx bx-door-open me-1 fs-5'></i>
                        @if (e?.CurrentRoom != null)
                        {
                            <span>@e.CurrentRoom.RoomName (@e.CurrentRoom.RoomCode)</span>
                        }
                        else
                        {
                            <span class="text-muted italic">Chưa gán phòng / Lưu kho</span>
                        }
                    </strong>
                </div>
                <div class="col-12 col-sm-6">
                    <span class="text-muted small d-block">Số Serial (S/N)</span>
                    <strong class="text-dark">@(e?.SerialNumber ?? "—")</strong>
                </div>
            </div>
        </div>

        <form asp-action="Transfer" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@(e?.EquipmentId)" />

            <!-- Chọn Phòng đích -->
            <div class="mb-3">
                <label for="targetRoomId" class="form-label fw-semibold text-secondary small">
                    Phòng học đích <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class='bx bx-log-in-circle'></i></span>
                    <select id="targetRoomId" name="targetRoomId" 
                            class="form-select bg-light border-start-0 @(ViewData.ModelState["targetRoomId"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                            asp-items="ViewBag.Rooms" required>
                        <option value="">-- Chọn phòng học đích --</option>
                    </select>
                </div>
                @if (ViewData.ModelState["targetRoomId"]?.Errors.Count > 0)
                {
                    <div class="invalid-feedback d-block">
                        @ViewData.ModelState["targetRoomId"]?.Errors.FirstOrDefault()?.ErrorMessage
                    </div>
                }
            </div>

            <!-- Lý do điều chuyển -->
            <div class="mb-4">
                <label for="reason" class="form-label fw-semibold text-secondary small">Lý do điều chuyển</label>
                <textarea id="reason" name="reason" rows="3" class="form-control bg-light" 
                          placeholder="Mô tả lý do điều chuyển thiết bị này (Ví dụ: Chuyển máy chiếu sang R102 do máy chiếu bên đó bị hỏng, điều chuyển định kỳ...)" required></textarea>
                <div class="form-text text-muted small mt-1">
                    <i class='bx bx-info-circle me-1'></i> Lịch sử điều chuyển vị trí sẽ tự động được ghi nhận vào hệ thống nhật ký `Transfer History`.
                </div>
            </div>

            <!-- Action buttons -->
            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-medium">
                    <i class='bx bx-x me-1'></i> Hủy bỏ
                </a>
                <button type="submit" class="btn btn-primary-custom px-4 fw-semibold">
                    <i class='bx bx-save me-1'></i> Xác nhận điều chuyển
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .fs-sm { font-size: 0.8rem; }
    .italic { font-style: italic; }
</style>
