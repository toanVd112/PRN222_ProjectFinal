@model IEnumerable<PRN_Project.Models.IncidentReport>
@{
    ViewData["Title"] = "Báo cáo sự cố";
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1 fw-bold text-dark">
                <i class='bx bx-error-circle me-2 text-danger'></i>Xử Lý Báo Cáo Sự Cố
            </h3>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Báo cáo sự cố</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class='bx bx-check-circle fs-4 me-2'></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class='bx bx-error-circle fs-4 me-2'></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
        </div>
    }

    <!-- Filter Card -->
    <div class="card card-premium mb-4">
        <form method="get" asp-action="Incidents" class="row g-3 align-items-end">
            <div class="col-12 col-md-8">
                <label class="form-label fw-semibold text-secondary small">Tìm kiếm sự cố</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class='bx bx-search'></i></span>
                    <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control bg-light border-start-0 ps-0" placeholder="Nhập mã tài sản, tên thiết bị, phòng học, mô tả...">
                </div>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold text-secondary small">Trạng thái sự cố</label>
                <select name="status" class="form-select bg-light" asp-items="ViewBag.Statuses">
                    <option value="">-- Tất cả trạng thái --</option>
                </select>
            </div>
        </form>
    </div>

    <!-- Data Table -->
    <div class="card card-premium">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="border-0 ps-3">Thiết bị / Mã tài sản</th>
                        <th class="border-0">Vị trí</th>
                        <th class="border-0">Mô tả sự cố</th>
                        <th class="border-0">Người báo / Thời gian</th>
                        <th class="border-0">Người xử lý</th>
                        <th class="border-0">Trạng thái</th>
                        <th class="border-0 text-center pe-3" style="width: 280px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-semibold text-dark">@item.Equipment.EquipmentName</div>
                                    <small class="text-primary fw-medium">@item.Equipment.AssetCode</small>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class='bx bx-door-open me-1 text-secondary fs-5'></i>
                                        <span>@item.Room.RoomName</span>
                                    </div>
                                </td>
                                <td style="max-width: 250px;">
                                    <div class="text-wrap small text-secondary">@item.Description</div>
                                </td>
                                <td>
                                    <div class="small">
                                        <i class='bx bx-user me-1 text-muted'></i>@item.ReportedByNavigation.FullName<br />
                                        <i class='bx bx-time-five me-1 text-muted'></i>@item.ReportedAt.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </td>
                                <td>
                                    @if (item.AssignedToNavigation != null)
                                    {
                                        <span class="small text-dark"><i class='bx bx-wrench me-1 text-muted'></i>@item.AssignedToNavigation.FullName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic small">Chưa phân công</span>
                                    }
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "Pending":
                                            <span class="badge bg-warning-subtle text-warning px-2.5 py-1.5 border border-warning-subtle rounded-pill">Chờ xử lý</span>
                                            break;
                                        case "InProgress":
                                            <span class="badge bg-info-subtle text-info px-2.5 py-1.5 border border-info-subtle rounded-pill">Đang xử lý</span>
                                            break;
                                        case "Resolved":
                                            <span class="badge bg-success-subtle text-success px-2.5 py-1.5 border border-success-subtle rounded-pill">Đã khắc phục</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark px-2.5 py-1.5 rounded-pill">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <div class="d-flex justify-content-center gap-2">
                                        @if (item.Status != "Resolved")
                                        {
                                            <button type="button" 
                                                    class="btn btn-primary btn-sm px-2.5 rounded-3 d-flex align-items-center gap-1"
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#resolveModal" 
                                                    data-id="@item.IncidentId" 
                                                    data-asset="@item.Equipment.AssetCode" 
                                                    data-name="@item.Equipment.EquipmentName">
                                                <i class='bx bx-check'></i> Khắc phục tại chỗ
                                            </button>
                                            <a asp-action="CreateMaintenanceTicket" asp-route-incidentId="@item.IncidentId" 
                                               class="btn btn-outline-warning btn-sm px-2.5 rounded-3 d-flex align-items-center gap-1" title="Gửi sửa ngoài">
                                                <i class='bx bx-wrench'></i> Gửi sửa ngoài
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" 
                                                    class="btn btn-outline-secondary btn-sm px-2.5 rounded-3 d-flex align-items-center gap-1" 
                                                    data-bs-toggle="popover" 
                                                    title="Thông tin giải quyết" 
                                                    data-bs-content="Giải quyết lúc: @item.ResolvedAt?.ToString("dd/MM/yyyy HH:mm"). Ghi chú: @item.ResolutionNote">
                                                <i class='bx bx-info-circle'></i> Chi tiết xử lý
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class='bx bx-info-circle fs-1 mb-2 d-block text-secondary'></i>
                                Không có báo cáo sự cố nào được ghi nhận.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Resolve Modal -->
<div class="modal fade" id="resolveModal" tabindex="-1" aria-labelledby="resolveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fw-bold text-dark" id="resolveModalLabel">
                    <i class='bx bx-check-double me-1 text-success'></i>Xác Nhận Khắc Phục Sự Cố
                </h5>
                <button type="button" class="btn-close" data-bs-close="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ResolveIncident" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalIncidentId" value="" />
                
                <div class="modal-body">
                    <div class="bg-light p-3 rounded-3 mb-3 small text-secondary">
                        <div><strong>Thiết bị:</strong> <span id="modalDeviceName" class="text-dark"></span></div>
                        <div><strong>Mã tài sản:</strong> <span id="modalAssetCode" class="text-primary fw-medium"></span></div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="resolutionNote" class="form-label fw-semibold text-secondary small">Nội dung / Biện pháp xử lý <span class="text-danger">*</span></label>
                        <textarea id="resolutionNote" name="resolutionNote" rows="3" class="form-control" placeholder="Mô tả chi tiết phương án khắc phục sự cố (Ví dụ: Đã cắm lại dây nguồn bị lỏng, Đã thay bóng đèn máy chiếu mới...)" required></textarea>
                    </div>
                </div>
                
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-success px-4">
                        <i class='bx bx-check me-1'></i>Hoàn tất xử lý
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .bg-success-subtle { background-color: #d1e7dd !important; }
    .text-success { color: #0f5132 !important; }
    .border-success-subtle { border-color: #a3cfbb !important; }
    
    .bg-warning-subtle { background-color: #fff3cd !important; }
    .text-warning { color: #664d03 !important; }
    .border-warning-subtle { border-color: #ffe69c !important; }
    
    .bg-info-subtle { background-color: #cff4fc !important; }
    .text-info { color: #055160 !important; }
    .border-info-subtle { border-color: #9eeaf9 !important; }

    .italic { font-style: italic; }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Debounce automatic filter
            const searchInput = document.querySelector('input[name="search"]');
            const statusSelect = document.querySelector('select[name="status"]');
            const filterForm = searchInput.closest('form');

            let debounceTimeout;
            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimeout);
                const value = this.value.trim();

                if (value === '') {
                    window.location.href = '@Url.Action("Incidents", "Technician")';
                    return;
                }

                debounceTimeout = setTimeout(() => {
                    filterForm.submit();
                }, 400);
            });

            statusSelect.addEventListener('change', function () {
                filterForm.submit();
            });

            if (searchInput.value.length > 0) {
                searchInput.focus();
                const val = searchInput.value;
                searchInput.value = '';
                searchInput.value = val;
            }

            // Setup Resolve Modal details when opening
            const resolveModal = document.getElementById('resolveModal');
            if (resolveModal) {
                resolveModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    const asset = button.getAttribute('data-asset');
                    const name = button.getAttribute('data-name');

                    document.getElementById('modalIncidentId').value = id;
                    document.getElementById('modalDeviceName').textContent = name;
                    document.getElementById('modalAssetCode').textContent = asset;
                    document.getElementById('resolutionNote').value = '';
                });
            }

            // Initialize Popovers
            const popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
            popoverTriggerList.map(function (popoverTriggerEl) {
                return new bootstrap.Popover(popoverTriggerEl, {
                    trigger: 'focus'
                });
            });
        });
    </script>
}
