@model PRN_Project.Models.TechnicianIncidentListViewModel

@{
    ViewData["Title"] = "Quản lý Sự cố & Bảo trì";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="mb-1 text-primary fw-bold">Danh sách Sự cố phòng học</h2>
            <p class="text-muted mb-0">Tiếp nhận, xử lý và theo dõi bảo trì thiết bị từ báo cáo giảng viên.</p>
        </div>
    </div>

    <!-- Feedback messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 border-start border-success border-4" role="alert">
            <i class='bx bx-check-circle me-2 fs-5 align-middle text-success'></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 border-start border-danger border-4" role="alert">
            <i class='bx bx-error-circle me-2 fs-5 align-middle text-danger'></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm border-0 border-start border-warning border-4" role="alert">
            <i class='bx bx-error-circle me-2 fs-5 align-middle text-warning'></i>
            @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Glassmorphic Filter Card -->
    <div class="card border-0 shadow-sm mb-4 bg-white rounded-3">
        <div class="card-body p-4">
            <form id="filterForm" method="get" class="row g-3">
                <!-- Auto-Search Input -->
                <div class="col-md-5">
                    <label for="SearchInput" class="form-label fw-semibold text-muted">Tìm kiếm sự cố</label>
                    <div class="input-group input-group-merge">
                        <span class="input-group-text bg-light border-end-0"><i class='bx bx-search text-muted'></i></span>
                        <input type="text" id="SearchInput" name="search" value="@Model.Search" class="form-control bg-light border-start-0" placeholder="Nhập mã thiết bị, tên máy, phòng học..." autocomplete="off">
                    </div>
                </div>

                <!-- Status Filter -->
                <div class="col-md-3">
                    <label for="StatusSelect" class="form-label fw-semibold text-muted">Trạng thái sự cố</label>
                    <select id="StatusSelect" name="status" class="form-select bg-light">
                        <option value="">-- Tất cả trạng thái --</option>
                        @foreach (var status in Model.Statuses)
                        {
                            <option value="@status.Value" selected="@(Model.Status == status.Value ? "selected" : null)">@status.Text</option>
                        }
                    </select>
                </div>

                <!-- Room Filter -->
                <div class="col-md-4">
                    <label for="RoomSelect" class="form-label fw-semibold text-muted">Phòng học báo sự cố</label>
                    <select id="RoomSelect" name="roomId" class="form-select bg-light">
                        <option value="">-- Tất cả phòng --</option>
                        @foreach (var room in Model.Rooms)
                        {
                            <option value="@room.Value" selected="@(Model.RoomId?.ToString() == room.Value ? "selected" : null)">@room.Text</option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted uppercase fs-7">
                    <tr>
                        <th style="width: 10%">Mã sự cố</th>
                        <th style="width: 15%">Phòng học</th>
                        <th style="width: 20%">Thiết bị báo hỏng</th>
                        <th style="width: 25%">Chi tiết mô tả lỗi</th>
                        <th style="width: 15%">Trạng thái</th>
                        <th style="width: 15%">Thời gian & Người gửi</th>
                        <th style="width: 5%" class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody id="incidentTableBody">
                    <partial name="_IncidentTableBody" model="Model.Incidents" />
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const $searchInput = $('#SearchInput');
            const $statusSelect = $('#StatusSelect');
            const $roomSelect = $('#RoomSelect');
            const $tableBody = $('#incidentTableBody');
            
            let debounceTimer;

            // Trigger search with delay
            function triggerSearch() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(performAjaxSearch, 300);
            }

            // Perform AJAX search
            function performAjaxSearch() {
                const searchVal = $searchInput.val();
                const statusVal = $statusSelect.val();
                const roomVal = $roomSelect.val();

                // Build query params
                const params = new URLSearchParams();
                if (searchVal) params.append('search', searchVal);
                if (statusVal) params.append('status', statusVal);
                if (roomVal) params.append('roomId', roomVal);

                // Add visual loading state
                $tableBody.css('opacity', '0.5');

                fetch(`@Url.Action("Index", "TechnicianIncidents")?${params.toString()}`, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (!response.ok) throw new Error('Search failed');
                    return response.text();
                })
                .then(html => {
                    $tableBody.html(html);
                    // Reset visual loading state
                    $tableBody.css('opacity', '1');
                })
                .catch(error => {
                    console.error('Error during live incidents search:', error);
                    $tableBody.css('opacity', '1');
                });
            }

            // Bind events for live updating
            $searchInput.on('input', triggerSearch);
            $statusSelect.on('change', performAjaxSearch);
            $roomSelect.on('change', performAjaxSearch);
        });
    </script>
}
