@model PRN_Project.Models.MaintenanceTicketViewModel

@{
    ViewData["Title"] = "Lập Phiếu Bảo trì ngoại";
}

<div class="container py-4">
    <!-- Back to details -->
    <div class="mb-4">
        <a asp-action="Details" asp-route-id="@Model.IncidentId" class="btn btn-link text-decoration-none text-muted p-0 d-inline-flex align-items-center">
            <i class='bx bx-left-arrow-alt fs-4 me-1'></i> Quay lại chi tiết sự cố
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-info text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class='bx bx-file me-2 align-middle fs-5'></i>Lập Phiếu Bảo trì Thiết bị ngoài
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info border-0 shadow-sm mb-4">
                        <h6 class="fw-bold mb-1 text-info-emphasis"><i class='bx bx-info-circle me-1.5 align-middle'></i>Lưu ý gửi sửa ngoài:</h6>
                        <p class="mb-0 fs-7">Sau khi lập phiếu bảo trì ngoài, thiết bị này sẽ được gán trạng thái <strong>Đang bảo trì ngoài (UnderMaintenance)</strong>. Sự cố liên quan sẽ tiếp tục được giữ ở trạng thái đang xử lý cho tới khi bạn nhận máy về và cập nhật chi phí thực tế.</p>
                    </div>

                    <!-- Equipment Summary -->
                    <div class="row bg-light rounded p-3 mb-4 g-3 border">
                        <div class="col-md-6">
                            <span class="text-muted d-block fs-8 uppercase fw-semibold">Mã thiết bị</span>
                            <span class="text-dark fw-bold">@Model.AssetCode</span>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted d-block fs-8 uppercase fw-semibold">Tên thiết bị</span>
                            <span class="text-dark fw-medium">@Model.EquipmentName</span>
                        </div>
                    </div>

                    <form asp-action="CreateTicket" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IncidentId" />
                        <input type="hidden" asp-for="EquipmentId" />
                        <input type="hidden" asp-for="AssetCode" />
                        <input type="hidden" asp-for="EquipmentName" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Service Provider -->
                        <div class="mb-3">
                            <label asp-for="ServiceProvider" class="form-label fw-semibold text-dark">Đơn vị sửa chữa/Nhà cung cấp dịch vụ <span class="text-danger">*</span></label>
                            <input asp-for="ServiceProvider" class="form-control" placeholder="Tên công ty sửa chữa, trung tâm bảo hành hãng..." required />
                            <span asp-validation-for="ServiceProvider" class="text-danger"></span>
                            <small class="text-muted d-block mt-1">Đơn vị nhận thiết bị để xử lý phần cứng ngoài trường.</small>
                        </div>

                        <div class="row g-3 mb-3">
                            <!-- Estimated Cost -->
                            <div class="col-md-6">
                                <label asp-for="EstimatedCost" class="form-label fw-semibold text-dark">Chi phí sửa chữa ước tính (VNĐ)</label>
                                <input asp-for="EstimatedCost" type="number" min="0" step="1000" class="form-control" placeholder="Nhập chi phí dự kiến..." />
                                <span asp-validation-for="EstimatedCost" class="text-danger"></span>
                                <small class="text-muted d-block mt-1">Phục vụ cho việc thống kê ngân sách.</small>
                            </div>

                            <!-- Expected Return Date -->
                            <div class="col-md-6">
                                <label asp-for="ExpectedReturnDate" class="form-label fw-semibold text-dark">Ngày dự kiến trả máy <span class="text-danger">*</span></label>
                                <input asp-for="ExpectedReturnDate" type="date" value="@Model.ExpectedReturnDate.ToString("yyyy-MM-dd")" class="form-control" required />
                                <span asp-validation-for="ExpectedReturnDate" class="text-danger"></span>
                                <small class="text-muted d-block mt-1">Ngày hẹn bàn giao lại thiết bị từ đơn vị sửa chữa.</small>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                            <a asp-action="Details" asp-route-id="@Model.IncidentId" class="btn btn-light border">Hủy bỏ</a>
                            <button type="submit" class="btn btn-info px-4 text-white shadow-sm">Xác nhận lập phiếu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
