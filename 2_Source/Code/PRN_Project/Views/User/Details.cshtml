@model PRN_Project.Models.UserDetailsViewModel

@{
    ViewData["Title"] = "Chi tiết tài khoản";
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 text-gray-800"><i class='bx bx-user-detail'></i> Chi tiết tài khoản</h2>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary me-2 shadow-sm">
                <i class='bx bx-arrow-back'></i> Quay lại
            </a>
            <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-primary shadow-sm">
                <i class='bx bx-edit-alt'></i> Chỉnh sửa
            </a>
        </div>
    </div>

    <!-- Profile Card -->
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? $"https://ui-avatars.com/api/?name={Model.FullName}&background=4F46E5&color=fff&size=128" : Model.AvatarUrl)" 
                             alt="Avatar" class="rounded-circle shadow" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid #fff;">
                        <h4 class="mt-3 mb-1 fw-bold text-dark">@Model.FullName</h4>
                        <p class="text-muted mb-0">@Model.UserCode</p>
                    </div>

                    <hr class="my-4 text-muted opacity-25">

                    <div class="row mb-3 align-items-center">
                        <div class="col-sm-4 text-muted fw-semibold"><i class='bx bx-envelope me-1'></i> Email</div>
                        <div class="col-sm-8 fw-medium text-dark">@Model.Email</div>
                    </div>

                    <div class="row mb-3 align-items-center">
                        <div class="col-sm-4 text-muted fw-semibold"><i class='bx bx-badge-check me-1'></i> Vai trò</div>
                        <div class="col-sm-8">
                            @if (Model.Role == "Admin")
                            {
                                <span class="badge bg-danger px-3 py-2 rounded-pill shadow-sm"><i class='bx bx-shield-quarter'></i> Admin</span>
                            }
                            else if (Model.Role == "Technician")
                            {
                                <span class="badge bg-info text-dark px-3 py-2 rounded-pill shadow-sm"><i class='bx bx-wrench'></i> Kỹ thuật viên</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2 rounded-pill shadow-sm"><i class='bx bx-chalkboard'></i> Giảng viên</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3 align-items-center">
                        <div class="col-sm-4 text-muted fw-semibold"><i class='bx bx-power-off me-1'></i> Trạng thái</div>
                        <div class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill border border-success-subtle shadow-sm"><i class='bx bx-check-circle'></i> Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill border border-secondary-subtle shadow-sm"><i class='bx bx-lock-alt'></i> Đã khóa</span>
                            }
                        </div>
                    </div>

                    <div class="row align-items-center">
                        <div class="col-sm-4 text-muted fw-semibold"><i class='bx bx-calendar-event me-1'></i> Ngày tạo</div>
                        <div class="col-sm-8 fw-medium text-dark">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
