@model PRN_Project.Models.RoomListViewModel

@{
    ViewData["Title"] = "Quản lý Phòng học";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 text-gray-800"><i class='bx bx-door-open'></i> Quản lý Phòng học</h2>
        @if (User.IsInRole("Admin"))
        {
            <div>
                <a asp-action="ActivityHistory" class="btn btn-secondary shadow-sm me-2">
                    <i class='bx bx-history'></i> Lịch sử hoạt động
                </a>
                <a asp-action="Create" class="btn btn-primary shadow-sm">
                    <i class='bx bx-plus-circle'></i> Thêm phòng mới
                </a>
            </div>
        }
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách Phòng học</h6>
        </div>
        <div class="card-body">
            <form method="get" id="filterForm" class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class='bx bx-search'></i></span>
                        <input type="text" class="form-control" name="searchTerm" id="searchTermInput"
                               placeholder="Tìm theo mã, tên, vị trí..." value="@Model.SearchTerm">
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="typeFilter" onchange="document.getElementById('filterForm').submit()">
                        <option value="">-- Tất cả loại phòng --</option>
                        <option value="Phòng học (P)" selected="@(Model.TypeFilter == "Phòng học (P)" ? "selected" : null)">Phòng học (P)</option>
                        <option value="Phòng LAB" selected="@(Model.TypeFilter == "Phòng LAB" ? "selected" : null)">Phòng LAB</option>
                        <option value="Nhà vệ sinh (WC)" selected="@(Model.TypeFilter == "Nhà vệ sinh (WC)" ? "selected" : null)">Nhà vệ sinh (WC)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="statusFilter" onchange="document.getElementById('filterForm').submit()">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Active" selected="@(Model.StatusFilter == "Active" ? "selected" : null)">Đang hoạt động</option>
                        <option value="Inactive" selected="@(Model.StatusFilter == "Inactive" ? "selected" : null)">Tạm ngưng</option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class='bx bx-reset'></i> Đặt lại
                    </a>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã phòng</th>
                            <th>Loại phòng</th>
                            <th>Vị trí</th>
                            <th>Sức chứa</th>
                            <th class="text-center">Trạng thái</th>
                            @if (User.IsInRole("Admin"))
                            {
                                <th class="text-center">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rooms.Any())
                        {
                            foreach (var item in Model.Rooms)
                            {
                                <tr>
                                    <td class="fw-bold">@item.RoomCode</td>
                                    <td>
                                        @if (item.RoomType == "Phòng học (P)")
                                        {
                                            <span class="badge bg-primary"><i class='bx bx-book-reader'></i> Học lý thuyết</span>
                                        }
                                        else if (item.RoomType == "Phòng LAB")
                                        {
                                            <span class="badge bg-warning text-dark"><i class='bx bx-desktop'></i> Thực hành (LAB)</span>
                                        }
                                        else if (item.RoomType == "Phòng hội trường")
                                        {
                                            <span class="badge bg-info text-white"><i class='bx bx-group'></i> Hội trường</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class='bx bx-buildings'></i> @item.RoomType</span>
                                        }
                                    </td>
                                    <td>@item.Location</td>
                                    <td>@(item.Capacity?.ToString() ?? "-")</td>
                                    <td class="text-center">
                                        @if (item.IsActive == true)
                                        {
                                            <span class="badge bg-success"><i class='bx bx-check-circle'></i> Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class='bx bx-x-circle'></i> Tạm ngưng</span>
                                        }
                                    </td>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <a asp-action="Equipments" asp-route-id="@item.RoomId" class="btn btn-sm btn-outline-info" title="Xem thiết bị">
                                                    <i class='bx bx-devices'></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.RoomId" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                                    <i class='bx bx-edit-alt'></i>
                                                </a>
                                                <form asp-action="ToggleStatus" asp-route-id="@item.RoomId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn thay đổi trạng thái phòng này?');">
                                                    @if (item.IsActive == true)
                                                    {
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Tạm ngưng">
                                                            <i class='bx bx-lock-alt'></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Mở khóa">
                                                            <i class='bx bx-lock-open-alt'></i>
                                                        </button>
                                                    }
                                                </form>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(User.IsInRole("Admin") ? "7" : "6")" class="text-center py-4 text-muted">
                                    <i class='bx bx-info-circle fs-4 d-block mb-2'></i>
                                    Không tìm thấy phòng học nào phù hợp.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.CurrentPage - 1)" 
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-typeFilter="@Model.TypeFilter">
                                <i class='bx bx-chevron-left'></i>
                            </a>
                        </li>
                        
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@i" 
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-typeFilter="@Model.TypeFilter">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.CurrentPage + 1)" 
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-typeFilter="@Model.TypeFilter">
                                <i class='bx bx-chevron-right'></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-submit with debounce for search input
        let typingTimer;
        const doneTypingInterval = 500;
        const searchInput = document.getElementById('searchTermInput');
        const filterForm = document.getElementById('filterForm');

        if (searchInput) {
            searchInput.addEventListener('keyup', function () {
                clearTimeout(typingTimer);
                typingTimer = setTimeout(() => {
                    filterForm.submit();
                }, doneTypingInterval);
            });

            searchInput.addEventListener('keydown', function () {
                clearTimeout(typingTimer);
            });
        }
    </script>
}
