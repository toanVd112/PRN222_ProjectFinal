@model PRN_Project.Models.RoomEquipmentsViewModel

@{
    ViewData["Title"] = $"Thiết bị phòng {Model.Room.RoomCode}";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 text-gray-800 mb-1"><i class='bx bx-door-open'></i> Danh sách thiết bị</h2>
            <p class="text-muted mb-0">Phòng: <strong>@Model.Room.RoomCode</strong> - @Model.Room.Location</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class='bx bx-arrow-back'></i> Quay lại
        </a>
    </div>

    <div class="card shadow border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã tài sản</th>
                            <th>Tên thiết bị</th>
                            <th>Danh mục</th>
                            <th>Tình trạng</th>
                            <th>Ngày cập nhật</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Equipments.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class='bx bx-box fs-1 d-block mb-2 text-black-50'></i>
                                    Hiện tại chưa có thiết bị nào trong phòng này.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model.Equipments)
                        {
                            <tr>
                                <td class="fw-bold">@item.AssetCode</td>
                                <td class="fw-medium text-dark">@item.EquipmentName</td>
                                <td>@item.Category.CategoryName</td>
                                <td>
                                    @if (item.Status == "Hoạt động tốt")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class='bx bx-check-circle'></i> @item.Status</span>
                                    }
                                    else if (item.Status == "Đang báo hỏng" || item.Status == "Cần bảo trì")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle"><i class='bx bx-error'></i> @item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><i class='bx bx-info-circle'></i> @item.Status</span>
                                    }
                                </td>
                                <td>@(item.UpdatedAt?.ToString("dd/MM/yyyy") ?? item.CreatedAt.ToString("dd/MM/yyyy"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
