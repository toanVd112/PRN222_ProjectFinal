@model List<PRN_Project.Models.EquipmentListItemViewModel>

@if (!Model.Any())
{
    <tr>
        <td colspan="7" class="text-center text-muted py-4">
            <i class='bx bx-search-alt-2 fs-2 d-block mb-2'></i>
            Không tìm thấy thiết bị nào khớp với điều kiện lọc.
        </td>
    </tr>
}
else
{
    foreach (var item in Model)
    {
        <tr>
            <td class="fw-bold">@item.AssetCode</td>
            <td>@item.EquipmentName</td>
            <td><span class="badge bg-light text-dark border">@item.CategoryName</span></td>
            <td><span class="text-muted"><i class='bx bx-door-open me-1'></i>@item.RoomDisplayName</span></td>
            <td>
                @switch (item.Status)
                {
                    case "InUse":
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5"><i class='bx bx-check-circle me-1'></i>Đang sử dụng</span>
                        break;
                    case "PendingRepair":
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1.5"><i class='bx bx-error-circle me-1'></i>Chờ sửa chữa</span>
                        break;
                    case "UnderMaintenance":
                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2.5 py-1.5"><i class='bx bx-wrench me-1'></i>Đang bảo trì</span>
                        break;
                    case "ProposedDisposal":
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5"><i class='bx bx-trash me-1'></i>Đề xuất thanh lý</span>
                        break;
                    case "Disposed":
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1.5"><i class='bx bx-block me-1'></i>Đã thanh lý</span>
                        break;
                    default:
                        <span class="badge bg-light text-dark border px-2.5 py-1.5">@item.Status</span>
                        break;
                }
            </td>
            <td>@(item.WarrantyExpiry?.ToString("dd/MM/yyyy") ?? "Không có")</td>
            <td class="text-end">
                <div class="btn-group">
                    <a asp-action="Details" asp-route-id="@item.EquipmentId" class="btn btn-sm btn-outline-info me-1" title="Xem lịch sử & Chi tiết">
                        <i class='bx bx-history'></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.EquipmentId" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                        <i class='bx bx-edit-alt'></i>
                    </a>
                </div>
            </td>
        </tr>
    }
}
