@model PRN_Project.Models.ProposeTransferViewModel

@{
    ViewData["Title"] = $"Đề xuất luân chuyển {Model.AssetCode}";
}

<div class="container py-4">
    <!-- Navigation back -->
    <div class="mb-4">
        <a asp-action="Transfers" class="btn btn-link text-decoration-none text-muted p-0 d-inline-flex align-items-center">
            <i class='bx bx-left-arrow-alt fs-4 me-1'></i> Quay lại danh sách điều chuyển
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class='bx bx-transfer me-2 align-middle fs-5'></i>Đề xuất Luân chuyển Thiết bị
                    </h5>
                </div>
                <div class="card-body p-4">
                    <!-- Summary of Equipment -->
                    <div class="row bg-light rounded p-3 mb-4 g-3 border">
                        <div class="col-md-6">
                            <span class="text-muted d-block fs-8 uppercase fw-semibold">Mã tài sản</span>
                            <span class="text-dark fw-bold">@Model.AssetCode</span>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted d-block fs-8 uppercase fw-semibold">Tên thiết bị</span>
                            <span class="text-dark fw-medium">@Model.EquipmentName</span>
                        </div>
                        <div class="col-12 border-top pt-2 mt-2">
                            <span class="text-muted d-block fs-8 uppercase fw-semibold">Vị trí hiện tại</span>
                            <span class="text-primary fw-bold"><i class='bx bx-door-open me-1'></i>@Model.CurrentRoomDisplayName</span>
                        </div>
                    </div>

                    <form asp-action="ProposeTransfer" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="EquipmentId" />
                        <input type="hidden" asp-for="AssetCode" />
                        <input type="hidden" asp-for="EquipmentName" />
                        <input type="hidden" asp-for="CurrentRoomId" />
                        <input type="hidden" asp-for="CurrentRoomDisplayName" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Target Room -->
                        <div class="mb-3">
                            <label asp-for="ToRoomId" class="form-label fw-semibold text-dark">Phòng học điều chuyển đến <span class="text-danger">*</span></label>
                            <select asp-for="ToRoomId" asp-items="Model.Rooms" class="form-select">
                                <option value="">-- Chọn phòng học đích --</option>
                            </select>
                            <span asp-validation-for="ToRoomId" class="text-danger"></span>
                            <small class="text-muted d-block mt-1"><i class='bx bx-info-circle me-1'></i>Chọn phòng học sẽ bàn giao thiết bị. Danh sách đã lọc bỏ phòng học hiện tại.</small>
                        </div>

                        <!-- Transfer Reason -->
                        <div class="mb-3">
                            <label asp-for="Reason" class="form-label fw-semibold text-dark">Lý do điều chuyển <span class="text-danger">*</span></label>
                            <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Nhập lý do điều chuyển (ví dụ: Chuyển thay thế cho máy chiếu phòng 202 bị hỏng, Luân chuyển định kỳ...)"></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                            <small class="text-muted d-block mt-1"><i class='bx bx-info-circle me-1'></i>Ghi rõ nguyên nhân để phục vụ truy vết lịch sử sau này. Tối thiểu 5 ký tự.</small>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                            <a asp-action="Transfers" class="btn btn-light border">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">Gửi đề xuất luân chuyển</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
