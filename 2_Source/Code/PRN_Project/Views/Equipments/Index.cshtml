@model PRN_Project.Models.EquipmentListViewModel

@{
    ViewData["Title"] = "Kho Thiết bị";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="mb-1 text-primary fw-bold">Kho Thiết bị phòng học</h2>
            <p class="text-muted mb-0">Quản lý, tìm kiếm và cập nhật trạng thái thiết bị trong hệ thống.</p>
        </div>
        <div class="col-auto">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary d-flex align-items-center shadow-sm">
                    <i class='bx bx-plus-circle fs-5 me-1.5'></i> Thêm thiết bị mới
                </a>
            }
        </div>
    </div>

    <!-- Glassmorphic Filter Card -->
    <div class="card border-0 shadow-sm mb-4 bg-white rounded-3">
        <div class="card-body p-4">
            <form id="filterForm" method="get" class="row g-3">
                <!-- Auto-Search Input -->
                <div class="col-md-4">
                    <label for="SearchInput" class="form-label fw-semibold text-muted">Tìm kiếm thiết bị</label>
                    <div class="input-group input-group-merge">
                        <span class="input-group-text bg-light border-end-0"><i class='bx bx-search text-muted'></i></span>
                        <input type="text" id="SearchInput" name="search" value="@Model.Search" class="form-control bg-light border-start-0" placeholder="Nhập tên, mã tài sản hoặc số serial..." autocomplete="off">
                    </div>
                </div>

                <!-- Category Filter -->
                <div class="col-md-3">
                    <label for="CategorySelect" class="form-label fw-semibold text-muted">Loại thiết bị</label>
                    <select id="CategorySelect" name="categoryId" class="form-select bg-light">
                        <option value="">-- Tất cả loại --</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Value" selected="@(Model.CategoryId?.ToString() == cat.Value ? "selected" : null)">@cat.Text</option>
                        }
                    </select>
                </div>

                <!-- Room Filter -->
                <div class="col-md-3">
                    <label for="RoomSelect" class="form-label fw-semibold text-muted">Phòng học</label>
                    <select id="RoomSelect" name="roomId" class="form-select bg-light">
                        <option value="">-- Tất cả phòng --</option>
                        <option value="0" selected="@(Model.RoomId == 0 ? "selected" : null)">Kho (Chưa phân bổ)</option>
                        @foreach (var room in Model.Rooms)
                        {
                            <option value="@room.Value" selected="@(Model.RoomId?.ToString() == room.Value ? "selected" : null)">@room.Text</option>
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="col-md-2">
                    <label for="StatusSelect" class="form-label fw-semibold text-muted">Trạng thái</label>
                    <select id="StatusSelect" name="status" class="form-select bg-light">
                        <option value="">-- Tất cả --</option>
                        @foreach (var status in Model.Statuses)
                        {
                            <option value="@status.Value" selected="@(Model.Status == status.Value ? "selected" : null)">@status.Text</option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm bg-white rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted uppercase fs-7">
                    <tr>
                        <th style="width: 15%">Mã tài sản</th>
                        <th style="width: 25%">Tên thiết bị</th>
                        <th style="width: 15%">Loại</th>
                        <th style="width: 15%">Vị trí hiện tại</th>
                        <th style="width: 15%">Trạng thái</th>
                        <th style="width: 15%">Bảo hành</th>
                        <th style="width: 5%" class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody id="equipmentTableBody">
                    <partial name="_EquipmentTableBody" model="Model.Equipments" />
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top-0 pt-3">
            <nav>
                <ul class="pagination justify-content-end mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-roomId="@Model.RoomId" asp-route-status="@Model.Status">Trang trước</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-roomId="@Model.RoomId" asp-route-status="@Model.Status">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-roomId="@Model.RoomId" asp-route-status="@Model.Status">Trang sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const $searchInput = $('#SearchInput');
            const $categorySelect = $('#CategorySelect');
            const $roomSelect = $('#RoomSelect');
            const $statusSelect = $('#StatusSelect');
            const $tableBody = $('#equipmentTableBody');
            
            let debounceTimer;

            // Trigger search with delay
            function triggerSearch() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(performAjaxSearch, 300);
            }

            // Perform AJAX search
            function performAjaxSearch() {
                const searchVal = $searchInput.val();
                const categoryVal = $categorySelect.val();
                const roomVal = $roomSelect.val();
                const statusVal = $statusSelect.val();

                // Build query params
                const params = new URLSearchParams();
                if (searchVal) params.append('search', searchVal);
                if (categoryVal) params.append('categoryId', categoryVal);
                if (roomVal) params.append('roomId', roomVal);
                if (statusVal) params.append('status', statusVal);

                // Add visual loading state
                $tableBody.css('opacity', '0.5');

                fetch(`@Url.Action("Index", "Equipments")?${params.toString()}`, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (!response.ok) throw new Error('Search failed');
                    return response.text();
                })
                .then(html => {
                    $tableBody.html(html);
                    // Reset visual loading state
                    $tableBody.css('opacity', '1');
                })
                .catch(error => {
                    console.error('Error during live search:', error);
                    $tableBody.css('opacity', '1');
                });
            }

            // Bind events for live updating
            $searchInput.on('input', triggerSearch);
            $categorySelect.on('change', performAjaxSearch);
            $roomSelect.on('change', performAjaxSearch);
            $statusSelect.on('change', performAjaxSearch);
        });
    </script>
}
