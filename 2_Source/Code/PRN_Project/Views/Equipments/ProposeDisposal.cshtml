@model PRN_Project.Models.EquipmentProposeDisposalViewModel

@{
    ViewData["Title"] = $"Đề xuất thanh lý {Model.AssetCode}";
}

<div class="container py-4">
    <!-- Navigation back -->
    <div class="mb-4">
        <a asp-action="Details" asp-route-id="@Model.EquipmentId" class="btn btn-link text-decoration-none text-muted p-0 d-inline-flex align-items-center">
            <i class='bx bx-left-arrow-alt fs-4 me-1'></i> Quay lại chi tiết thiết bị
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class='bx bx-trash me-2 align-middle fs-5'></i>Đề xuất thanh lý Thiết bị
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning border-0 shadow-sm mb-4">
                        <h6 class="fw-bold mb-1 text-warning-emphasis"><i class='bx bx-warning me-1.5 align-middle'></i>Lưu ý về quy trình thanh lý:</h6>
                        <p class="mb-0 fs-7">Sau khi bạn nhấn gửi đề xuất, thiết bị này sẽ ngay lập tức được chuyển sang trạng thái <strong>Đề xuất thanh lý</strong> và một yêu cầu phê duyệt sẽ được gửi tới Ban quản lý (Admin). Bạn sẽ không thể sửa đổi thông tin hoặc luân chuyển phòng học đối với thiết bị này cho đến khi Admin đưa ra quyết định.</p>
                    </div>

                    <!-- Equipment Summary -->
                    <div class="row bg-light rounded p-3 mb-4 g-3 border">
                        <div class="col-md-6">
                            <span class="text-muted d-block fs-8 uppercase fw-semibold">Mã tài sản</span>
                            <span class="text-dark fw-bold">@Model.AssetCode</span>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted d-block fs-8 uppercase fw-semibold">Tên thiết bị</span>
                            <span class="text-dark fw-medium">@Model.EquipmentName</span>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted d-block fs-8 uppercase fw-semibold">Vị trí hiện tại</span>
                            <span class="text-dark">@Model.RoomDisplayName</span>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted d-block fs-8 uppercase fw-semibold">Trạng thái hiện tại</span>
                            <span class="text-danger fw-medium">@Model.Status</span>
                        </div>
                    </div>

                    <form asp-action="ProposeDisposal" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="EquipmentId" />
                        <input type="hidden" asp-for="AssetCode" />
                        <input type="hidden" asp-for="EquipmentName" />
                        <input type="hidden" asp-for="RoomDisplayName" />
                        <input type="hidden" asp-for="Status" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Reason input -->
                        <div class="mb-3">
                            <label asp-for="Reason" class="form-label fw-semibold text-dark">Lý do đề xuất thanh lý <span class="text-danger">*</span></label>
                            <textarea asp-for="Reason" class="form-control" rows="4" placeholder="Mô tả chi tiết nguyên nhân hỏng hóc hoặc lý do thiết bị này không còn khả năng sửa chữa, bảo trì ngoài..."></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                            <small class="text-muted d-block mt-1"><i class='bx bx-info-circle me-1'></i>Cung cấp lý do cụ thể và rõ ràng để Admin duyệt nhanh chóng. Tối thiểu 10 ký tự.</small>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                            <a asp-action="Details" asp-route-id="@Model.EquipmentId" class="btn btn-light border">Hủy bỏ</a>
                            <button type="submit" class="btn btn-danger px-4 shadow-sm">Gửi đề xuất thanh lý</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
