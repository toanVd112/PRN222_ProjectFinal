@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container-fluid py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-5">
                    <i class='bx bx-error-circle text-danger' style="font-size: 5rem;"></i>
                    <h2 class="mt-4 fw-bold text-dark">Từ chối truy cập</h2>
                    <p class="text-muted mt-3 mb-4">
                        Xin lỗi, bạn không có quyền truy cập vào chức năng này. Chức năng này yêu cầu quyền quản trị viên.
                    </p>
                    <a href="javascript:history.back()" class="btn btn-primary me-2">
                        <i class='bx bx-arrow-back me-1'></i> Quay lại trang trước
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        <i class='bx bx-home me-1'></i> Về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
